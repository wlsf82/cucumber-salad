{
  "name": "cucumber-salad",
  "version": "1.0.0",
  "description": "Sample project to integrate Cypress with the Cucumber plugin.",
  "main": "cypress.config.js",
  "scripts": {
    "cy:open": "cypress open",
    "test": "cypress run",
    "test:smoke": "cypress run --env grepTags=@smoke",
    "test:not:smoke": "cypress run --env grepTags=-@smoke",
    "test:engagesphere": "cypress run --spec 'cypress/e2e/EngageSphere/**/*.cy.js'",
    "test:hackerstories": "cypress run --spec 'cypress/e2e/HackerStories/**/*.cy.js'"
  },
  "keywords": [
    "cypress-io",
    "cucumber",
    "testing"
  ],
  "author": "Walmyr <wlsf82@gmail.com> (https://walmyr.dev/)",
  "license": "MIT",
  "devDependencies": {
    "cypress": "^15.2.0",
    "@cypress/grep": "^4.1.1"
  }
}
